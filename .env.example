# Database
DATABASE_URL=postgresql://stay_admin:stay_password@localhost:5432/stay_bg
# Connections per server instance. Keep it low on serverless (many instances share
# the database's connection limit); use a pooler URL (e.g. PgBouncer) in production.
DATABASE_POOL_MAX=10

# Auth
BETTER_AUTH_SECRET=replace-with-a-32-character-minimum-secret
BETTER_AUTH_URL=http://localhost:3000

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend). Without these, development prints each email — including
# verification and password-reset links — to the server log; in production every send fails.
RESEND_API_KEY=
EMAIL_FROM="Stay.bg <noreply@stay.bg>"

# Photo uploads (Vercel Blob). Without it, uploads return 503 UPLOADS_NOT_CONFIGURED.
BLOB_READ_WRITE_TOKEN=

# Map tiles (Leaflet). Defaults to OpenStreetMap's own servers, which allow development
# and light traffic only: set a tile provider for production. The CSP img-src follows
# the URL's host ({s} subdomains become a wildcard). The attribution is HTML.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Social sign-in (optional). Each button appears only when both of its values are set.
# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# (Web application). Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: developers.facebook.com > your app > Facebook Login > Settings.
# Valid OAuth redirect URI: <BETTER_AUTH_URL>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
